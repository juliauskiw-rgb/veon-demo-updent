---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/site.css";
import forumCyr from "@fontsource/forum/files/forum-cyrillic-400-normal.woff2?url";

interface Props { lang: string; title: string; description: string; }
const { lang, title, description } = Astro.props;
// Canonical: absolute when SITE_URL is set for the build (astro.config `site`), otherwise the page path with base.
const path = import.meta.env.BASE_URL;
const canonical = Astro.site ? new URL(path, Astro.site).href : path;
---
<!doctype html>
<html lang={lang} data-rec="R-001">
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} data-rec="R-004" />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={forumCyr} as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="uk_UA" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}favicon.png`} />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}apple-touch-icon.png`} />
    <meta name="theme-color" content="#14390F" />
    <meta name="robots" content="noindex" />
    <slot name="head" />
    <style is:global>html, body { overflow-x: clip; }</style>
  </head>
  <body>
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main" tabindex="-1"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/motion.ts"></script>
  </body>
</html>
