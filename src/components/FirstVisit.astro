---
import Section from "./Section.astro";
import Icon from "./Icon.astro";
import { TEL, VIBER } from "../data/clinic";
---
<Section id="pershyi-vizyt" rec="UX-R002,UX-R004" class="plate visit">
  <div class="container visit__grid">
    <h2>Перший візит</h2>
    <dl class="visit__prices">
      <div><dt>Консультація з планом лікування</dt><dd class="num">600 грн</dd></div>
      <div><dt>Дитяча консультація</dt><dd class="num">500 грн</dd></div>
    </dl>
    <div class="visit__cta">
      <a class="btn btn--primary" href={TEL}><Icon name="phone" />Записатися телефоном</a>
      <a class="btn btn--ghost" href={VIBER}><Icon name="viber" />Viber</a>
    </div>
  </div>
</Section>

<style>
  .visit { padding-block: clamp(48px, 2rem + 3vw, 72px); }
  .visit__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s4) var(--gutter); align-items: start; }
  h2 { grid-column: 1 / span 3; align-self: start; }
  .visit__prices { grid-column: 4 / span 6; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--gutter); margin: 0; }
  .visit__prices div { display: flex; flex-direction: column; gap: var(--s1); border-left: 1px solid var(--color-line-on-brand); padding-left: var(--s3); }
  dt { color: var(--color-on-brand-2); max-width: 18ch; }
  dd { order: -1; margin: 0; font-family: var(--font-display); font-size: var(--fs-big); line-height: 1; color: var(--color-on-brand); }
  .visit__cta { grid-column: 10 / span 3; display: grid; gap: 12px; }
  @media (max-width: 1199px) {
    h2 { grid-column: 1 / -1; }
    .visit__prices { grid-column: 1 / -1; }
    .visit__cta { grid-column: 1 / -1; display: flex; flex-wrap: wrap; }
  }
  @media (max-width: 559px) {
    .visit__prices { grid-template-columns: minmax(0, 1fr); gap: var(--s3); }
    .visit__cta { flex-direction: column; }
    .visit__cta .btn { width: 100%; }
  }
</style>
