---
// «Послуги і ціни»: prices only from S-F006 (прайс сайту клініки, 2026-11-19); no price in facts = «ціна у прайсі».
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import { FUTURE } from "../data/clinic";

type Row = { name: string; price?: string; note?: string };
const groups: { title: string; area: string; rows: Row[] }[] = [
  { title: "Перевірити і лікувати", area: "a", rows: [
    { name: "Консультація з планом лікування", price: "600 грн" },
    { name: "Комплексна професійна гігієна", price: "2 500–2 900 грн" },
    { name: "Терапія" },
    { name: "Ендодонтія з мікроскопом" },
    { name: "Пародонтологія" },
  ] },
  { title: "Відновити", area: "b", rows: [
    { name: "Цирконієва коронка", price: "13 500–14 900 грн" },
    { name: "Хірургія" },
    { name: "Імплантація NEODENT або OSSTEM", note: "під ключ", price: "53 900 грн" },
    { name: "Імплантація STRAUMANN ROXOLID", note: "під ключ", price: "68 000 грн" },
  ] },
  { title: "Вирівняти", area: "c", rows: [
    { name: "Брекети Damon, кераміка", price: "80 000 грн" },
    { name: "Елайнери Orthero", price: "140 000 грн" },
    { name: "Елайнери Invisalign", price: "250 000 грн" },
  ] },
  { title: "Естетика", area: "d", rows: [
    { name: "Відбілювання двох щелеп", price: "7 500 грн" },
  ] },
];
---
<Section id="posluhy" rec="UX-R004" class="section prices">
  <div class="container">
    <div class="prices__head">
      <h2>Послуги і ціни</h2>
      <p>Ціни з чинного прайсу клініки. Точну суму лікування лікар складає на консультації.</p>
    </div>
    <div class="prices__grid">
      {groups.map((g, i) => (
        <details class={`grp grp--${g.area}`} open data-price-group>
          <summary><h3>{g.title}</h3><span class="grp__toggle" aria-hidden="true"></span></summary>
          <ul>
            {g.rows.map((r) => (
              <li>
                <FutureLink note={FUTURE} class="row">
                  <span class="row__name">{r.name}{r.note && <span class="row__note">{r.note}</span>}</span>
                  {r.price ? <span class="row__price num">{r.price}</span> : <span class="row__price row__price--none">ціна у прайсі</span>}
                </FutureLink>
              </li>
            ))}
          </ul>
        </details>
      ))}
    </div>
    <div class="prices__foot">
      <a class="prices__kids" href="#dity"><span>Дітям: консультація <span class="num">500&nbsp;грн</span></span></a>
      <FutureLink note={FUTURE} class="future-tag">Повний прайс: 14 категорій</FutureLink>
    </div>
  </div>
</Section>

<style>
  .prices__head { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--gutter); align-items: end; margin-bottom: var(--s5); }
  .prices__head h2 { grid-column: 1 / span 6; }
  .prices__head p { grid-column: 8 / span 5; color: var(--color-text-2); }
  .prices__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr) minmax(0, 3fr); grid-template-areas: "a b c" "a b d"; column-gap: var(--gutter); border-top: 1px solid var(--color-text); }
  .grp { padding-top: var(--s3); }
  .grp--a { grid-area: a; } .grp--b { grid-area: b; } .grp--c { grid-area: c; } .grp--d { grid-area: d; padding-top: var(--s5); }
  .grp + .grp { border-left: 1px solid var(--color-line); padding-left: var(--gutter); }
  .grp--d { border-left: 1px solid var(--color-line); padding-left: var(--gutter); }
  summary { list-style: none; display: flex; align-items: center; justify-content: space-between; gap: var(--s2); margin-bottom: var(--s2); }
  summary::-webkit-details-marker { display: none; }
  .grp__toggle { display: none; }
  li { border-bottom: 1px solid var(--color-line); }
  .prices :global(.row) { display: flex; width: 100%; justify-content: space-between; align-items: baseline; gap: var(--s2); min-height: var(--tap); padding: 12px 8px 12px 0; isolation: isolate; }
  .prices :global(.row)::before { content: ""; position: absolute; inset: 0 -8px; background: var(--color-surface); transform: scaleX(0); transform-origin: left; transition: transform 200ms var(--ease-out); z-index: -1; }
  .prices :global(.row:hover)::before, .prices :global(.row:focus-visible)::before { transform: scaleX(1); }
  .row__name { font-weight: 500; font-size: 1.0625rem; line-height: 1.35; }
  .row__note { display: block; font-weight: 400; font-size: var(--fs-small); color: var(--color-text-2); }
  .row__price { font-weight: 600; text-align: right; }
  .row__price--none { font-weight: 400; font-size: var(--fs-small); color: var(--color-text-2); white-space: nowrap; }
  .prices__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--s2) var(--s4); margin-top: var(--s4); }
  .prices__kids { font-weight: 500; color: var(--color-brand); text-decoration: underline; text-underline-offset: 0.22em; display: inline-block; padding-block: 12px; line-height: 1.3; }
  .prices__kids:hover { text-decoration-thickness: 2px; }

  @media (max-width: 1023px) {
    .prices__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "a b" "c d"; }
    .grp--c { border-left: 0 !important; padding-left: 0 !important; }
    .grp--d { padding-top: var(--s3); }
    .prices__head h2, .prices__head p { grid-column: 1 / -1; }
    .prices__head { gap: var(--s2); }
  }
  @media (max-width: 767px) {
    .prices__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: "a" "b" "c" "d"; border-top: 0; }
    .grp, .grp + .grp, .grp--d { border-left: 0; padding: 0; border-top: 1px solid var(--color-text); }
    .grp:last-child { border-bottom: 1px solid var(--color-text); }
    summary { min-height: 64px; margin: 0; cursor: pointer; }
    .grp__toggle { display: block; position: relative; width: 16px; height: 16px; }
    .grp__toggle::before, .grp__toggle::after { content: ""; position: absolute; left: 0; top: 7px; width: 16px; height: 1.5px; background: var(--color-text); transition: transform 200ms var(--ease-out); }
    .grp__toggle::after { transform: rotate(90deg); }
    .grp[open] .grp__toggle::after { transform: rotate(0deg); }
    .grp ul { padding-bottom: var(--s2); }
    li:last-child { border-bottom: 0; }
    .prices :global(.row) { padding-block: 16px; }
  }
</style>

<script>
  // Desktop: all price groups stay open as columns. Phone (< 768 px): groups fold, the first one stays open.
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>("[data-price-group]"));
  const phone = window.matchMedia("(max-width: 767px)");
  const apply = () => groups.forEach((g, i) => { g.open = phone.matches ? i === 0 : true; });
  apply();
  phone.addEventListener("change", apply);
  groups.forEach((g) => g.querySelector("summary")?.addEventListener("click", (e) => { if (!phone.matches) e.preventDefault(); }));
</script>
