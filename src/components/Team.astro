---
// Team from S-F003 (names as published in the team block of the clinic site; actuality is a client decision).
// One group photo: the doctors' portraits available from the old site are too small to show sharply.
import { Picture } from "astro:assets";
import Section from "./Section.astro";
import FutureLink from "./FutureLink.astro";
import group from "../assets/client/team-group.png";
import { FUTURE } from "../data/clinic";

const doctors = [
  { role: "Терапевт, ендодонтист", name: "Анжела Білинська" },
  { role: "Терапевт", name: "Юлія Гаврушко" },
  { role: "Дитячий стоматолог", name: "Марта Пухар" },
  { role: "Ортодонт", name: "Марта Грицик" },
  { role: "Ортопед", name: "Олег Грицик" },
  { role: "Хірург-імплантолог", name: "Андрій Рудь" },
];
---
<Section id="komanda" class="section team">
  <div class="container team__grid">
    <div class="team__list">
      <h2>6 лікарів на 4 поверсі</h2>
      <p class="team__lead">Хто вас лікуватиме: терапія, ендодонтія, дитячий прийом, ортодонтія, ортопедія та імплантація.</p>
      <ul>
        {doctors.map((d) => (
          <li>
            <FutureLink note={FUTURE} class="doc">
              <span class="doc__role">{d.role}</span>
              <span class="doc__name">{d.name}</span>
            </FutureLink>
          </li>
        ))}
      </ul>
      <p class="team__also">А також 3 асистенти, рентгенолог-лаборант і 3 адміністратори.</p>
    </div>
    <div class="team__stage">
      <div class="shot">
        <Picture src={group} formats={["avif", "webp"]} widths={[390, 476]} sizes="(max-width: 767px) 100vw, 50vw" alt="Команда клініки UP Dent: лікарі, асистенти й адміністратори" data-rec="R-012" />
      </div>
    </div>
  </div>
</Section>

<style>
  .team { padding-top: var(--s5); }
  .team__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--s5) var(--gutter); align-items: start; }
  .team__list { grid-column: 1 / span 5; }
  .team__list ul { margin-top: var(--s4); border-top: 1px solid var(--color-text); }
  .team__list li { border-bottom: 1px solid var(--color-line); }
  .team :global(.doc) { display: flex; flex-direction: column; align-items: flex-start; width: 100%; padding: var(--s2) 0; min-height: var(--tap); }
  .doc__role { font-family: var(--font-display); font-size: var(--fs-h3); line-height: 1.1; transition: transform 200ms var(--ease-out); }
  .doc__name { font-size: 0.9375rem; color: var(--color-text-2); margin-top: 4px; }
  .team :global(.doc:hover) .doc__role { transform: translateX(8px); }
  .team__also { margin-top: var(--s3); color: var(--color-text-2); max-width: 40ch; }
  .team__stage { grid-column: 7 / span 6; position: sticky; top: calc(var(--header-h) + var(--s3)); display: grid; background: var(--color-surface); }
  .shot { grid-area: 1 / 1; }
  .shot :global(img) { width: 100%; height: auto; aspect-ratio: 476 / 316; object-fit: cover; object-position: 50% 40%; }
  .team__lead { margin-top: var(--s2); color: var(--color-text-2); max-width: 44ch; }
  @media (max-width: 1023px) {
    .team__list { grid-column: 1 / span 6; }
    .team__stage { grid-column: 7 / span 6; }
  }
  @media (max-width: 767px) {
    .team__list, .team__stage { grid-column: 1 / -1; }
    .team__stage { position: static; margin-inline: calc(-1 * var(--space)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .doc__role { transition: none; }
  }
</style>

